# Server only. This file contains no credentials. Never prefix a secret with VITE_.
NODE_ENV=development
PORT=8080
APP_ORIGIN=http://127.0.0.1:5173
PROVIDER_MODE=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TTS_MODEL=
# B2 試聽選定 voice=cedar（填在 repo 外的 env 檔）；留空則 TTS 降級 mock。
OPENAI_TTS_VOICE=
# 選填：覆寫預設的繁中台灣國語聲線指示（≤1500 字元）；空值使用內建 B2 instructions。
OPENAI_TTS_INSTRUCTIONS=
# --- Spotify E 模式（預設全關；見 docs/spotify-e-mode.md，啟用屬 L2，不要在這個檔案打開）---
# SPOTIFY_ENABLED=true 需要 CLIENT_ID、REDIRECT_URI、TOKEN_ENC_KEY 三項齊全，缺任一即拒絕啟動。
# SPOTIFY_DJ_APPROVED=true 另需 SPOTIFY_ENABLED=true 與非空的 SPOTIFY_APPROVAL_REFERENCE（票號＋時間）。
SPOTIFY_ENABLED=false
SPOTIFY_DJ_APPROVED=false
SPOTIFY_APPROVAL_REFERENCE=
# 非秘密，但只從 env 讀取、程式不寫死。示例：643a3f074bd74c039161010453a7e56f
SPOTIFY_CLIENT_ID=
# 必須與 Spotify Dashboard 完全一致；HTTPS（或明確 loopback IP 的 http），路徑為 /callback 或 /api/auth/spotify/callback。
# 示例：https://jaxpkmmac-mini.tailaa16c2.ts.net:10000/callback
SPOTIFY_REDIRECT_URI=
# refresh token 加密金鑰（32 bytes，base64 或 hex）：openssl rand -base64 32。放 repo 外、權限 600 的 env 檔，不要寫在這裡。
SPOTIFY_TOKEN_ENC_KEY=
# 加密 token 小檔位置（權限 600）；建議絕對路徑。空值＝./data/spotify-token.enc
SPOTIFY_TOKEN_FILE=
# 「愛」要加入的 Qualia Loved 歌單 ID；空值＝0dF9anAJZv0IotD6lo2kl2
SPOTIFY_LOVED_PLAYLIST_ID=
# Set a strong random value locally when enabling a real backend session.
SESSION_SECRET=
PLAN_DEADLINE_MS=60000
# 真實 LLM 產生 5–7 首中文候選常需 15–30 秒，LLM 單次逾時預設 30 秒（逾時的預扣仍保守保留）。
PROVIDER_TIMEOUT_MS=30000
# B2 聲線語速偏慢（約 60 字 13 秒），TTS 單次逾時放寬到 30 秒。
TTS_TIMEOUT_MS=30000
MAX_LLM_CALLS_PER_PLAN=2
# BRA-127：模型提名 8–12 首候選池，伺服器抽樣後逐首對應、不可播就補抽，最多試這麼多首（5–12）。
MAX_CANDIDATES_PER_PLAN=12
# 探索度 0–100：0＝關閉抽樣、照模型排序取前 5 首可播；越高越常抽到後段候選。同種子每多一輪近期紀錄再加 15。
PLAN_EXPLORATION_PCT=50
# 同種子排除最近幾輪已選的曲目（0–10；0＝不排除）。新曲不夠 5 首時才拿最早選過的回來補。
PLAN_RECENT_RUNS=3
PLAN_RATE_LIMIT_PER_HOUR=10
TTS_GRAPHEME_BUDGET_PER_DAY=4000
TTS_CACHE_DIR=./data/tts
TTS_CACHE_TTL_HOURS=24
TTS_CACHE_MAX_MB=100
# Mobile requires a trusted HTTPS origin reachable by the phone, with matching redirect.

# --- Mock-only tuning (ignored unless PROVIDER_MODE=mock) ---
# Synthetic test tone length per segment and simulated DJ chime length.
MOCK_TRACK_MS=30000
MOCK_SPEECH_MS=4000
# Delay per generation phase and the stalled phase used by the "slow" scenario.
MOCK_PHASE_MS=700
MOCK_SLOW_PHASE_MS=24000
SESSION_RATE_LIMIT_PER_MIN=30

# 品味帳本（BRA-134）：本機 JSON 檔（評價、標記、播出紀錄）；開台前必讀，不依賴 Notion。
# 建議填絕對路徑；空值＝./data/taste-ledger.json（啟動時轉成絕對路徑）。
TASTE_LEDGER_PATH=

# Optional external TEST check only; runtime defaults to in-memory fake. Never commit a token.
NOTION_TOKEN=

# --- OpenAI 真實供應商（預設不啟用；見 docs/openai-providers-and-budget.md）---
# 曄簽收上限後才可設 true；模型與單價沒有預設，必須填當期確認值，缺任一項即降級 mock。
# 金鑰不要寫在這裡：放 repo 外、權限 600 的 env 檔，以 node --env-file 載入。
OPENAI_REAL_CALLS_APPROVED=false
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_PRICE_INPUT_PER_1M_TOKENS=
OPENAI_PRICE_OUTPUT_PER_1M_TOKENS=
OPENAI_PRICE_TTS_PER_1M_CHARS=
# 硬上限，只能調低：每日 US$1、總額 US$10、每日 20 輪真實 plan（TTS 字數見上方 TTS_GRAPHEME_BUDGET_PER_DAY）。
BUDGET_DAILY_USD=1
BUDGET_TOTAL_USD=10
BUDGET_MAX_PLANS_PER_DAY=20
# 真實呼叫啟用時必須改為絕對路徑（相對路徑會降級 mock）。首次建立時同目錄另寫 sentinel「<路徑>.initialized」；
# 之後帳本若不見但 sentinel 仍在，會停用真實呼叫、不自動重建，需人工復原（見文件「帳本遺失的人工處理」）。
BUDGET_LEDGER_PATH=./data/budget-ledger.json
# 緊急停止：設 true，或建立 KILL_SWITCH_FILE（執行中立即生效，不需重啟）。
REAL_PROVIDERS_KILL_SWITCH=false
KILL_SWITCH_FILE=./data/KILL_SWITCH

# BRA-161：匿名 session＋最小回饋上下文；單程序私有檔案，重啟重載
SESSION_STORE_PATH=./data/sessions.json
