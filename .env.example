# Server only. This file contains no credentials. Never prefix a secret with VITE_.
NODE_ENV=development
PORT=8080
APP_ORIGIN=http://127.0.0.1:5173
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/spotify/callback
PROVIDER_MODE=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
SPOTIFY_CLIENT_ID=
SPOTIFY_ENABLED=false
SPOTIFY_DJ_APPROVED=false
SPOTIFY_APPROVAL_REFERENCE=
# Set a strong random value locally when enabling a real backend session.
SESSION_SECRET=
PLAN_DEADLINE_MS=60000
PROVIDER_TIMEOUT_MS=8000
TTS_TIMEOUT_MS=15000
MAX_LLM_CALLS_PER_PLAN=2
MAX_CANDIDATES_PER_PLAN=10
PLAN_RATE_LIMIT_PER_HOUR=10
TTS_GRAPHEME_BUDGET_PER_DAY=4000
TTS_CACHE_DIR=./data/tts
TTS_CACHE_TTL_HOURS=24
TTS_CACHE_MAX_MB=100
# Mobile requires a trusted HTTPS origin reachable by the phone, with matching redirect.

# --- Mock-only tuning (ignored unless PROVIDER_MODE=mock) ---
# Synthetic test tone length per segment and simulated DJ chime length.
MOCK_TRACK_MS=30000
MOCK_SPEECH_MS=4000
# Delay per generation phase and the stalled phase used by the "slow" scenario.
MOCK_PHASE_MS=700
MOCK_SLOW_PHASE_MS=24000
SESSION_RATE_LIMIT_PER_MIN=30

# Optional external TEST check only; runtime defaults to in-memory fake. Never commit a token.
NOTION_TOKEN=

# --- OpenAI 真實供應商（預設不啟用；見 docs/openai-providers-and-budget.md）---
# 曄簽收上限後才可設 true；模型與單價沒有預設，必須填當期確認值，缺任一項即降級 mock。
# 金鑰不要寫在這裡：放 repo 外、權限 600 的 env 檔，以 node --env-file 載入。
OPENAI_REAL_CALLS_APPROVED=false
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_PRICE_INPUT_PER_1M_TOKENS=
OPENAI_PRICE_OUTPUT_PER_1M_TOKENS=
OPENAI_PRICE_TTS_PER_1M_CHARS=
# 硬上限，只能調低：每日 US$1、總額 US$10、每日 20 輪真實 plan（TTS 字數見上方 TTS_GRAPHEME_BUDGET_PER_DAY）。
BUDGET_DAILY_USD=1
BUDGET_TOTAL_USD=10
BUDGET_MAX_PLANS_PER_DAY=20
BUDGET_LEDGER_PATH=./data/budget-ledger.json
# 緊急停止：設 true，或建立 KILL_SWITCH_FILE（執行中立即生效，不需重啟）。
REAL_PROVIDERS_KILL_SWITCH=false
KILL_SWITCH_FILE=./data/KILL_SWITCH
