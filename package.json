{
  "name": "qualia-fm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @qualia/contracts build && pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "start": "node --env-file-if-exists=.env apps/server/dist/index.js",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "pnpm build && playwright test --project=mobile-360 --project=mobile-390 --project=mobile-430",
    "screenshots": "pnpm build && playwright test --project=screenshots",
    "e2e:webkit": "pnpm build && playwright test --project=webkit-390",
    "check:preferences": "node scripts/check-preferences.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
